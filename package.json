{
    "name": "mdx",
    "version": "0.3.0",
    "private": true,
    "description": "MDX desktop workspace",
    "author": "Jayden Wang",
    "license": "MIT",
    "scripts": {
        "dev": "next dev",
        "build": "npm run build:layout-wasm && next build",
        "build:layout-wasm": "node scripts/build-layout-wasm.mjs",
        "build:sidecars": "NODE_ENV=production node scripts/prepare-tauri-sidecars.mjs",
        "build:app": "npx tauri build",
        "install:local": "node scripts/install-local-app.mjs",
        "build:install": "npm run build:app && npm run install:local",
        "lint": "eslint",
        "test": "vitest run",
        "test:workspace": "vitest run features/workspace/lib/*.test.ts",
        "verify:layout-wasm": "npm run build:layout-wasm && node scripts/verify-layout-wasm.mjs",
        "audit:editor:boundaries": "node scripts/audit-editor-boundaries.mjs",
        "fixtures:editor:perf": "node scripts/generate-editor-perf-fixtures.mjs",
        "fixtures:editor:perf:check": "node scripts/generate-editor-perf-fixtures.mjs --check",
        "qualify:editor:environment": "node scripts/editor-perf-environment.mjs",
        "qualify:editor:smoke": "node scripts/measure-editor-qualification.mjs --smoke",
        "qualify:editor:verify": "node scripts/verify-editor-qualification.mjs",
        "qualify:editor:build": "NEXT_PUBLIC_MDX_MILKDOWN_QUALIFICATION=1 NEXT_PUBLIC_MDX_BUILD_COMMIT=$(git rev-parse HEAD) npm run build:app"
    },
    "dependencies": {
        "@codemirror/commands": "^6.10.3",
        "@codemirror/lang-markdown": "^6.5.0",
        "@codemirror/search": "^6.7.1",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.43.1",
        "@milkdown/kit": "7.22.1",
        "@tauri-apps/api": "2.10.1",
        "@tauri-apps/plugin-dialog": "^2.7.0",
        "daisyui": "^5.5.19",
        "immer": "^11.1.4",
        "katex": "^0.17.0",
        "lucide-react": "^1.17.0",
        "mdast-util-from-markdown": "^2.0.3",
        "mdast-util-frontmatter": "^2.0.1",
        "mdast-util-gfm": "^3.1.0",
        "mdast-util-math": "^3.0.0",
        "mermaid": "^11.15.0",
        "micromark": "^4.0.2",
        "micromark-extension-frontmatter": "^2.0.0",
        "micromark-extension-gfm": "^3.0.0",
        "micromark-extension-math": "^3.1.0",
        "nanoid": "^5.1.7",
        "next": "16.2.3",
        "prismjs": "^1.30.0",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.9",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.0",
        "prosemirror-view": "^1.41.9",
        "react": "19.2.4",
        "react-dom": "19.2.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@tailwindcss/postcss": "^4",
        "@tauri-apps/cli": "2.10.1",
        "@types/node": "^20",
        "@types/prismjs": "^1.26.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^9",
        "eslint-config-next": "16.2.3",
        "jsdom": "^29.1.1",
        "tailwindcss": "^4",
        "typescript": "^5",
        "vitest": "^4.0.14",
        "wasm-pack": "^0.15.0"
    }
}
